# Copy to .env. `pnpm dev` loads this and boots auth (:3100) + api (:8787) + admin (:5173).
# The per-app ports and cross-URLs are fixed inside each app's dev script — you
# only need to set the database and the auth secret here.

# --- Postgres ---
# The data layer + Better Auth both use this. Any standard Postgres works
# (local Homebrew/Docker, Neon, Supabase, RDS…). A role with CREATEROLE is
# needed so authzdx can create the anon/authenticated roles + apply RLS.
#   local Homebrew default:  postgres://<you>@localhost:5432/authzdx_dev
DATABASE_URL="postgres://postgres:postgres@localhost:5432/authzdx_dev"

# --- Auth (Better Auth) ---
# Session/JWT signing secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# OAuth providers (optional — fill the ones you use)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- Postgres (produção / dev com Postgres real) ---
# A camada de dados é runtime-agnostic. Em dev você pode usar pglite (sem Docker);
# em produção, um Postgres padrão.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/authzdx"

# --- Auth (Better Auth) ---
# Segredo para assinatura/sessão. Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# OAuth providers (preencha os que for usar)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
